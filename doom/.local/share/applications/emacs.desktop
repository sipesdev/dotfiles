# Shadows /usr/share/applications/emacs.desktop: the launcher opens terminal Emacs
# on the daemon, the same command as SUPER+SHIFT+E. Emacs (Client) stays the GUI entry.
[Desktop Entry]
Name=Emacs
GenericName=Text Editor
Comment=Edit text
MimeType=text/english;text/plain;text/x-makefile;text/x-c++hdr;text/x-c++src;text/x-chdr;text/x-csrc;text/x-java;text/x-moc;text/x-pascal;text/x-tcl;text/x-tex;application/x-shellscript;text/x-c;text/x-c++;
Exec=alacritty --class emacs -e emacsclient -t --alternate-editor= %F
Icon=emacs
Type=Application
Terminal=false
Categories=Development;TextEditor;
StartupNotify=false
StartupWMClass=emacs

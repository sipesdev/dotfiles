[Unit]
Description=Emacs daemon for the graphical session (Doom Emacs)
Documentation=info:emacs man:emacs(1) https://gnu.org/software/emacs/
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=notify
ExecStart=/usr/bin/emacs --fg-daemon
# A tty frame's color depth comes from the daemon's own COLORTERM (the copy
# emacsclient forwards is ignored), so without this `emacsclient -t` is stuck at
# 256 colors. Every terminal here is Alacritty or tmux inside it, both truecolor.
Environment=COLORTERM=truecolor
SuccessExitStatus=15
Restart=on-failure

[Install]
WantedBy=graphical-session.target

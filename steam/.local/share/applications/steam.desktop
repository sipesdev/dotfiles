# Shadows /usr/share/applications/steam.desktop: every entry point (launcher, the
# jump-list actions, steam:// links) starts Steam with -pipewire, so Remote Play
# desktop capture goes through the xdg-desktop-portal PipeWire stream on Wayland.
# The flag only takes effect when this launch starts the client; an action sent
# to an already-running Steam is forwarded without restarting it.
[Desktop Entry]
Name=Steam
Comment=Application for managing and playing games on Steam
Exec=/usr/bin/steam -pipewire %U
Icon=steam
Terminal=false
Type=Application
Categories=Network;FileTransfer;Game;
MimeType=x-scheme-handler/steam;x-scheme-handler/steamlink;
Actions=Store;Community;Library;Servers;Screenshots;News;Settings;BigPicture;Friends;
PrefersNonDefaultGPU=true
X-KDE-RunOnDiscreteGpu=true

[Desktop Action Store]
Name=Store
Exec=/usr/bin/steam -pipewire steam://store

[Desktop Action Community]
Name=Community
Exec=/usr/bin/steam -pipewire steam://url/CommunityHome/

[Desktop Action Library]
Name=Library
Exec=/usr/bin/steam -pipewire steam://open/games

[Desktop Action Servers]
Name=Servers
Exec=/usr/bin/steam -pipewire steam://open/servers

[Desktop Action Screenshots]
Name=Screenshots
Exec=/usr/bin/steam -pipewire steam://open/screenshots

[Desktop Action News]
Name=News
Exec=/usr/bin/steam -pipewire steam://openurl/https://store.steampowered.com/news

[Desktop Action Settings]
Name=Settings
Exec=/usr/bin/steam -pipewire steam://open/settings

[Desktop Action BigPicture]
Name=Big Picture
Exec=/usr/bin/steam -pipewire steam://open/bigpicture

[Desktop Action Friends]
Name=Friends
Exec=/usr/bin/steam -pipewire steam://open/friends

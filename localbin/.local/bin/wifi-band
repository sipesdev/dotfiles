#!/bin/bash
# Show or pin the Wi-Fi band of the active connection, for the Network popout's band pills.
#   wifi-band            -> band/available/selected lines (nothing if Wi-Fi is not connected)
#   wifi-band 5          -> pin the active profile to 5 GHz and reconnect (revert on failure)
#   wifi-band auto       -> unpin
# Pinning the band rather than a BSSID survives AP BSSID rotation and keeps roaming intact.
set -euo pipefail

nm_band_for()  { case "$1" in 2.4) echo bg ;; 5) echo a ;; 6) echo 6GHz ;; *) return 1 ;; esac; }
band_from_nm() { case "$1" in bg) echo 2.4 ;; a) echo 5 ;; 6GHz) echo 6 ;; *) echo auto ;; esac; }

# Band boundaries: 2.4 GHz = 2400-2499, 5 GHz = 4900-5924, 6 GHz = 5925-7124 MHz.
band_for_freq() {
    local mhz=${1%%[!0-9]*}
    [[ -n $mhz ]] || return 1
    if ((mhz >= 2400 && mhz < 2500)); then echo 2.4
    elif ((mhz >= 4900 && mhz < 5925)); then echo 5
    elif ((mhz >= 5925 && mhz < 7125)); then echo 6
    else return 1; fi
}

# LC_ALL=C: nmcli translates state words; -e no: -g would otherwise escape ':' in SSIDs.
nm_get() { LC_ALL=C nmcli -e no -g "$@" 2>/dev/null; }

wifi_device() { nm_get DEVICE,TYPE,STATE device status | awk -F: '$2 == "wifi" && $3 == "connected" { print $1; exit }'; }
wifi_profile() { nm_get GENERAL.CONNECTION device show "$1"; }
selected_band() { band_from_nm "$(nm_get 802-11-wireless.band connection show "$1")"; }

# Sets $ssid from the active profile (no colon parsing) and $freq from the in-use row of
# NM's cached scan list: "2412 MHz" / "5745 MHz"; band_for_freq keeps the digits.
read_link() {
    ssid=$(nm_get 802-11-wireless.ssid connection show "$2")
    freq=$(nm_get IN-USE,FREQ dev wifi list ifname "$1" --rescan no | awk -F: '$1 == "*" { print $2; exit }')
}

# Every band this SSID answers on, low to high, always including the one in use.
available_bands() {
    local device=$1 ssid=$2 current=$3
    {
        [[ -n $current ]] && echo "$current"
        nm_get FREQ,SSID dev wifi list ifname "$device" --rescan no |
            want="$ssid" awk -F: 'BEGIN { want = ENVIRON["want"] }
                { name = $2; for (i = 3; i <= NF; i++) name = name ":" $i; if (name == want) print $1 }' |
            while read -r f; do band_for_freq "$f" || true; done
    } | sort -u -g | tr '\n' ' ' | sed 's/ $//'
}

print_status() {
    local device profile band available
    device=$(wifi_device); [[ -n $device ]] || return 0
    profile=$(wifi_profile "$device"); [[ -n $profile ]] || return 0
    read_link "$device" "$profile"; [[ -n ${ssid:-} ]] || return 0
    band=$(band_for_freq "$freq" || true)
    available=$(available_bands "$device" "$ssid" "$band")
    printf 'band\t%s\n' "$band"
    printf 'available\t%s\n' "$available"
    printf 'selected\t%s\n' "$(selected_band "$profile")"
}

set_band() {
    local target=$1 device profile previous desired
    device=$(wifi_device) || true
    [[ -n $device ]] || { echo "wifi-band: no connected Wi-Fi device" >&2; exit 1; }
    profile=$(wifi_profile "$device")
    [[ -n $profile ]] || { echo "wifi-band: no active Wi-Fi profile" >&2; exit 1; }
    if [[ $target == auto ]]; then
        desired=""
    else
        read_link "$device" "$profile"
        if [[ " $(available_bands "$device" "$ssid" "$(band_for_freq "$freq" || true)") " != *" $target "* ]]; then
            echo "wifi-band: ${target} GHz is not available on this network" >&2; exit 1
        fi
        desired=$(nm_band_for "$target")
    fi
    previous=$(nm_get 802-11-wireless.band connection show "$profile")
    [[ $previous == "$desired" ]] && exit 0
    nmcli connection modify "$profile" 802-11-wireless.band "$desired" >/dev/null
    # A band change only takes effect on reassociation; if the radio cannot come back on the
    # requested band, restore the old setting and reconnect rather than strand the machine.
    if ! nmcli connection up "$profile" >/dev/null 2>&1; then
        nmcli connection modify "$profile" 802-11-wireless.band "$previous" >/dev/null || true
        nmcli connection up "$profile" >/dev/null 2>&1 || true
        echo "wifi-band: could not connect on ${target}; reverted" >&2; exit 1
    fi
}

case "${1:-}" in
    "") print_status ;;
    auto|2.4|5|6) set_band "$1" ;;
    *) echo "usage: wifi-band [auto|2.4|5|6]" >&2; exit 1 ;;
esac

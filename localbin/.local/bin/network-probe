#!/bin/bash
# Snapshot of the interface behind the default route, for the Network drawer's stats grid:
# iface/ip/gateway, cumulative rx/tx bytes (the drawer diffs them into rates), and a one-shot
# ping to 1.1.1.1. Tab-separated key/value lines; nothing at all when there is no route
# (undocked with Wi-Fi off). Port of omarchy-network-status --verbose, trimmed to what is shown.
set -uo pipefail

# Override only to exercise the no-route path (e.g. NETWORK_PROBE_TARGET=2001:db8::1 with no IPv6 route).
probe=${NETWORK_PROBE_TARGET:-1.1.1.1}

route_json=$(ip -j route get "$probe" 2>/dev/null) || exit 0
[[ -n $route_json ]] || exit 0
iface=$(jq -r '.[0].dev // ""' <<<"$route_json")
gw=$(jq -r '.[0].gateway // ""' <<<"$route_json")
src=$(jq -r '.[0].prefsrc // ""' <<<"$route_json")
[[ -n $iface ]] || exit 0

printf 'iface\t%s\n' "$iface"
printf 'ip\t%s\n' "$src"
printf 'gateway\t%s\n' "$gw"
[[ -r /sys/class/net/$iface/statistics/rx_bytes ]] && printf 'rx_bytes\t%s\n' "$(</sys/class/net/$iface/statistics/rx_bytes)"
[[ -r /sys/class/net/$iface/statistics/tx_bytes ]] && printf 'tx_bytes\t%s\n' "$(</sys/class/net/$iface/statistics/tx_bytes)"

# One packet, one-second deadline; an empty value means the probe timed out.
ping_ms() { LC_ALL=C ping -n -c 1 -W 1 "$1" 2>/dev/null | awk -F'time[=<]' '/time[=<]/ { split($2, p, " "); print p[1]; exit }'; }
printf 'internet_ping_ms\t%s\n' "$(ping_ms "$probe")"

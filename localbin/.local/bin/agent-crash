#!/bin/bash
# agent-crash -- launch the default agent to diagnose a systemd-coredump crash.
#
#   agent-crash <pid> [name] [exe] [signal]
#
# Clicked through from a "Process crashed:" toast (crash-watch), or run by hand
# against any PID in `coredumpctl list`. The method lives in the diagnose-crash
# skill so it is edited in one place; this only gathers facts and points at it.

set -euo pipefail

pid=${1:?usage: agent-crash <pid> [name] [exe] [signal]}
if [[ ! $pid =~ ^[0-9]+$ ]]; then
  echo "Not a PID: $pid   (see: coredumpctl list)" >&2
  exit 1
fi

name=${2:-unknown}
exe=${3:-unknown}
signal=${4:-unknown}

skill="$HOME/.agents/skills/diagnose-crash/SKILL.md"

# Looked up live so a hand-run PID still gets a timestamp. A rotated-away core
# only costs the timestamp, so failure is tolerated.
when=$(coredumpctl list "$pid" --no-pager --no-legend 2>/dev/null | tail -1 | cut -d' ' -f1-4) || true
when=${when:-unknown}

# The agent terminal inherits this cwd: diagnosis runs against the dotfiles
# repo, the one place it is allowed to fix.
cd "$HOME/Projects/dotfiles"

prompt=$(
  cat <<PROMPT
A process crashed on this machine and I want to know why.

What systemd-coredump recorded:
  process:  $name
  PID:      $pid
  binary:   $exe
  signal:   $signal
  time:     $when

Use the diagnose-crash skill: it covers how to investigate and what to report.
If your harness has no skill mechanism, read the skill file directly and follow
it instead:

  $skill

Fix the cause ONLY if it lies in this repo's configuration (~/Projects/dotfiles).
Otherwise just report your findings. Never file or comment on upstream issues.
PROMPT
)

exec "$HOME/.local/bin/agent" --prompt "$prompt"
